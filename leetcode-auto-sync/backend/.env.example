# Copy to .env for local testing, or set these as Application Settings
# in Azure App Service (Configuration > Application settings). Never commit
# a real .env file.

GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Once you know your extension's ID from chrome://extensions, lock CORS
# down to it instead of leaving this as "*":
# ALLOWED_EXTENSION_ORIGIN=chrome-extension://<your-extension-id>
ALLOWED_EXTENSION_ORIGIN=*

PORT=8080
